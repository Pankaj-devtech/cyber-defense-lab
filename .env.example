# Application
APP_NAME=Cyber Defense Lab
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (SQLite path inside the container/workdir)
DATABASE_URL=sqlite:///./data/cyber_defense.db

# Security
ALLOW_REGISTRATION=true
SIMULATION_MODE=true

# Dev seed (created automatically when users table is empty, non-production):
# admin@example.com / admin123
